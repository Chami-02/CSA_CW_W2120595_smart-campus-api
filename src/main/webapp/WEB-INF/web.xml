<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Smart Campus API</display-name>
    
    <!-- 
      Since JAX-RS 2.x, Servlet 3.x containers (like Tomcat 9+) auto-discover 
      the javax.ws.rs.core.Application subclass we provided, so we don't 
      strictly need to configure the org.glassfish.jersey.servlet.ServletContainer 
      here. However, an empty web.xml is highly recommended for standard 
      Netbeans deployment recognition.
    -->
    
</web-app>
